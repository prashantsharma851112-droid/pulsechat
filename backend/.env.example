PORT=5000
JWT_SECRET=replace_this_with_any_long_random_secret_string
MONGO_URI=your_mongodb_atlas_connection_string_here
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION
# ==============================================================================
# 1. BREVO REST API (RECOMMENDED FOR RENDER - 100% RELIABLE, NEVER BLOCKED)
# Render Free Tier blocks SMTP ports 25, 465, 587.
# Brevo uses standard HTTPS (port 443) and gives 300 free emails/day.
# Get free API key in 2 minutes: https://www.brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME="PulseChat Security"

# 2. OPTIONAL: RESEND REST API (HTTPS port 443)
# RESEND_API_KEY=re_your_api_key_here

# 3. DIRECT SMTP (Works on localhost & VPS; blocked on Render Free Tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password

# Google Sign-In (OAuth Client ID)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
