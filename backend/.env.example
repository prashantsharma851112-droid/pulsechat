# ==============================================================================
# PULSECHAT BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Never commit actual secret keys or private credentials to version control.
# ==============================================================================

# Server Network & URLs
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pulsechat?retryWrites=true&w=majority

# ==============================================================================
# SECURITY SECRETS (MANDATORY - MINIMUM 32 CHARACTERS)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
RECEIPT_SECRET=replace_with_another_secure_random_64_character_hex_string

# ==============================================================================
# WEB PUSH NOTIFICATIONS (VAPID RFC 8292)
# Generate a new P-256 VAPID keypair via web-push or Node.js crypto
# Never commit private keys to git repository.
# ==============================================================================
VAPID_PUBLIC_KEY=replace_with_your_base64url_uncompressed_p256_public_key
VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_your_pkcs8_pem_or_base64_private_key\n-----END PRIVATE KEY-----"
VAPID_SUBJECT=mailto:support@pulsechat.app

# ==============================================================================
# REDIS CACHE (OPTIONAL - UPSTASH / LOCAL REDIS)
# ==============================================================================
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION
# ==============================================================================
# 1. BREVO REST API (RECOMMENDED FOR RENDER - 100% RELIABLE HTTPS PORT 443)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@gmail.com
BREVO_SENDER_NAME="PulseChat Security"

# 2. DIRECT SMTP (Works on local dev & VPS; blocked on Render Free Tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password

# ==============================================================================
# GOOGLE OAUTH SIGN-IN
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ==============================================================================
# CLOUDINARY MEDIA STORAGE (OPTIONAL)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# RAZORPAY PAYMENTS (OPTIONAL)
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
